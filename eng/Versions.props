<Project>

  <PropertyGroup>
    <!-- Pinned bundled Claude Code Node CLI version (spec §10).
         Updated only as part of an SDK release; the native-bundle
         workflow downloads and packs this exact version per RID. -->
    <ClaudeCliVersion>2.1.126</ClaudeCliVersion>

    <!-- SDK version. Independent of ClaudeCliVersion (spec §16).
         Semver; 0.x while we track the Python SDK's pre-1.0 churn.
         Surfaced at runtime via ClaudeAgent.SdkVersion and on the wire
         via the CLAUDE_AGENT_SDK_VERSION env var. -->
    <SdkVersion>0.1.0-preview.1</SdkVersion>

    <!-- Default packable identity. Per-package csprojs may override. -->
    <Version>$(SdkVersion)</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

</Project>
