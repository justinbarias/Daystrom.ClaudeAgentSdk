<Project>
  <!--
    Shared properties for the five runtime.{rid}.Daystrom.ClaudeAgentSdk.Native
    csprojs. Each child csproj only needs to set <NativeRid> and <PackageId>.

    These projects do not produce compile output; they exist solely to pack
    a single native binary from runtimes/{rid}/native/ into a NuGet package
    that consumers of Daystrom.ClaudeAgentSdk pick up via NuGet's
    runtime-asset resolution.

    Phase 2 / Task 2.2 of the implementation plan.
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>

    <!-- No managed code in these packages. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Symbol packages would be empty (no managed code) and trip
         NU5017. Symbols re-enabled in Directory.Build.props for the
         managed projects landing in Phase 3+. -->
    <IncludeSymbols>false</IncludeSymbols>

    <!-- We intentionally produce a package with no lib/ folder. CS2008 is
         emitted because csc runs with no source files; expected here. -->
    <NoWarn>$(NoWarn);NU5128;NU5100;CS2008</NoWarn>

    <!-- Native sub-packages have no managed dependencies. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

    <!-- Identity is the same across the five RID projects; the consumer-
         facing PackageId is set per csproj. -->
    <Authors>Justin Barias</Authors>
    <Company>Justin Barias</Company>
    <PackageProjectUrl>https://github.com/jbarias/claude-agent-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jbarias/claude-agent-sdk-dotnet</RepositoryUrl>
    <PackageTags>anthropic;claude;agent;sdk;native;cli</PackageTags>
    <PackageDescription>Native `claude` CLI binary for $(NativeRid). Internal runtime payload for Daystrom.ClaudeAgentSdk; not consumed directly.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack runtimes/{rid}/native/* under runtimes/{rid}/native/ inside the
         .nupkg. NuGet's runtime-asset resolution unpacks the matching RID
         to the consumer's bin/.../runtimes/{rid}/native/ folder, where
         CliBinaryResolver (Phase 4.1) looks for it. -->
    <None
      Include="runtimes\$(NativeRid)\native\**\*"
      Pack="true"
      PackagePath="runtimes/$(NativeRid)/native"
    />
  </ItemGroup>
</Project>
