<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Anthropic.ClaudeAgentSdk</RootNamespace>
    <AssemblyName>Anthropic.ClaudeAgentSdk</AssemblyName>

    <!-- Core library opts in to AOT-compatibility (overrides the false default
         in the repo-level Directory.Build.props). The CI gate that enforces
         zero IL2*/IL3* warnings on PublishAot is added in Phase 15.4; until
         then, eng/aot-smoke is published manually at each phase checkpoint. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Public package metadata (spec §19 row "core"). -->
    <PackageId>Anthropic.ClaudeAgentSdk</PackageId>
    <PackageDescription>.NET SDK for the Claude Agent SDK. Wraps the bundled `claude` CLI and speaks the same stream-json wire protocol as the Python SDK. Zero-install: `dotnet add package` brings the CLI with it.</PackageDescription>
    <PackageTags>anthropic;claude;agent;sdk;ai;llm</PackageTags>
    <PackageProjectUrl>https://github.com/jbarias/claude-agent-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jbarias/claude-agent-sdk-dotnet</RepositoryUrl>

    <!-- Generate XML doc file for IntelliSense; spec §18 acceptance criterion. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Native runtime sub-package wiring lands in Phase 4 with CliBinaryResolver.
    See plan PR sequence: this csproj is intentionally dependency-free in Phase 3
    so wire-type compilation has the smallest possible surface to verify AOT
    cleanliness against.
  -->

  <!-- ClaudeAgentJsonContext is internal by design (spec §11). The test
       project and the AOT smoke harness need to instantiate it to verify
       round-trip + AOT cleanliness; both are friend assemblies. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Anthropic.ClaudeAgentSdk.Tests" />
    <InternalsVisibleTo Include="AotSmoke" />
  </ItemGroup>
</Project>
