# Copy to `.env` (gitignored) and fill in real values before launching the
# VS Code "Run integration tests" profiles in `.vscode/launch.json`.

# Required: enables IntegrationFactAttribute. Without this flag every
# [IntegrationFact] is silently skipped.
CLAUDE_INTEGRATION=1

# Required: pick ONE of the two credential vars below. The OAuth token
# takes precedence over ANTHROPIC_API_KEY when both are set.
CLAUDE_CODE_OAUTH_TOKEN=<YOUR_CLAUDE_CODE_OAUTH_TOKEN>
# ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
